PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/mood-journal
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=30d

# CORS (comma-separated origins, default: http://localhost:3000)
ALLOWED_ORIGINS=http://localhost:3000

# Email configuration (for verification codes)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# AI Configuration (GigaChat)
# Authorization Key из GigaChat Studio. Не client secret.
GIGACHAT_CREDENTIALS=your-gigachat-authorization-key
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_TIMEOUT=30
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# Для локальной разработки SDK часто используют false из-за корневого сертификата.
# В production лучше включить проверку сертификата и настроить доверенный CA.
GIGACHAT_REJECT_UNAUTHORIZED=false

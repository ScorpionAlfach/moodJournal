PORT=3000
NODE_ENV=production
MONGODB_URI=mongodb://localhost:27017/mood-journal
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_CHAR_STRING
JWT_EXPIRES_IN=30d

# CORS
ALLOWED_ORIGINS=https://moodjournal.ru,https://www.moodjournal.ru

# Email (SMTP) — заполнить своими данными
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=your-email@yandex.ru
SMTP_PASS=your-app-password
SMTP_FROM=your-email@yandex.ru

# AI Configuration (GigaChat)
GIGACHAT_CREDENTIALS=CHANGE_ME_TO_GIGACHAT_AUTHORIZATION_KEY
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_TIMEOUT=30
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_REJECT_UNAUTHORIZED=false
